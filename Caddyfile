# syntax=docker/dockerfile:1
FROM node:20-alpine AS base

# 1. 安装依赖
FROM base AS deps
RUN apk add --no-cache libc6-compat curl
WORKDIR /app

# #region agent log
# 验证 Hypothesis A (Node Version) 和 Hypothesis B (Prisma Schema Existence)
RUN node -v > /tmp/node_ver && \
    (ls -R prisma/schema.prisma > /tmp/prisma_check 2>&1 || echo "missing" > /tmp/prisma_check) && \
    curl -X POST -H "Content-Type: application/json" -d "{ \
      \"location\": \"Dockerfile:deps\", \
      \"message\": \"Build environment check\", \
      \"data\": { \
        \"nodeVersion\": \"$(cat /tmp/node_ver)\", \
        \"prismaSchema\": \"$(cat /tmp/prisma_check)\" \
      }, \
      \"sessionId\": \"debug-session\", \
      \"hypothesisId\": \"A,B\" \
    }" http://127.0.0.1:7242/ingest/f65876b8-d369-406a-9a51-3ce638039e4e || true
# #endregion

COPY package*.json ./
# 关键修复：在 npm ci 之前拷贝 prisma 目录
COPY prisma ./prisma/

RUN npm ci

# 2. 构建阶段
FROM base AS builder
RUN apk add --no-cache curl
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# #region agent log
RUN curl -X POST -H "Content-Type: application/json" -d "{ \
      \"location\": \"Dockerfile:builder\", \
      \"message\": \"Prisma generation starting\", \
      \"sessionId\": \"debug-session\", \
      \"hypothesisId\": \"B\" \
    }" http://127.0.0.1:7242/ingest/f65876b8-d369-406a-9a51-3ce638039e4e || true
# #endregion

RUN npx prisma generate

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

RUN npm run build

# 3. 运行阶段
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/prisma ./prisma

USER nextjs

EXPOSE 3000
ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

CMD ["sh", "-c", "npx prisma migrate deploy && npm run start"]